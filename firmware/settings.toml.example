CIRCUITPY_WIFI_SSID = "your-ssid"
CIRCUITPY_WIFI_PASSWORD = "your-password"

# Do NOT set CIRCUITPY_WEB_API_PASSWORD. It turns on CircuitPython's built-in
# Web Workflow, which binds port 80 (TailWatch's web UI needs that port) and
# exposes the whole CIRCUITPY filesystem -- including the API token stored in
# /prefs.json -- to anyone on the LAN who knows the password.

# The web UI's Wi-Fi form (saved via the setup AP, or later from the normal
# UI) rewrites only the two CIRCUITPY_WIFI_* keys above, moving them to the
# top of this file -- every other line here, including this comment, is kept
# as-is. The previous file is kept alongside as settings.toml.bak. A save
# needs a normal boot (not booted with UP held); see README.md.
